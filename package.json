{
  "name": "ask-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ask AI — conversational planner/executor assignment monorepo",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "server",
    "web",
    "eval"
  ],
  "scripts": {
    "dev": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "seed": "tsx server/src/scripts/seed.ts",
    "smoke": "tsx eval/smoke.ts",
    "probe": "tsx eval/probe.ts",
    "eval": "tsx eval/run.ts",
    "eval:quick": "tsx eval/run.ts --quick",
    "eval:baseline": "tsx eval/run.ts --baseline",
    "benchmark:report": "tsx eval/benchmark-report.ts",
    "build": "npm -w server run build && npm -w web run build",
    "test": "vitest run",
    "typecheck": "npm -w server run typecheck"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
