OPENROUTER_API_KEY=
PLANNER_MODEL=anthropic/claude-haiku-4.5
FAST_MODEL=google/gemini-2.5-flash-lite
PROFILE=standard
VIRTUAL_NOW=2026-11-04T10:00:00Z
EVAL_BUDGET_USD=25
PORT=3000
PROVIDER_ORDER=
# conversational replies; off for benchmarks (the eval runner strips this)
COMPOSER_POLISH=1
# Workspace/admin steering instructions injected into the agent's system prompt
# (org tone, fiscal calendar, naming/policy conventions). Optional.
ASKAI_WORKSPACE_INSTRUCTIONS=
# Web-search enrichment (native webSearch). Uses OpenRouter's built-in
# web plugin — NO separate search account, it reuses OPENROUTER_API_KEY above.
# Opt-in: the web__search tool is bound only when this flag is on.
WEB_SEARCH_ENABLED=
WEB_SEARCH_MAX=5
# Optional: model used to run the web search (defaults to FAST_MODEL).
WEB_SEARCH_MODEL=
